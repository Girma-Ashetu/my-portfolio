# Copy to .env and supply your own values. Do not commit the resulting .env.
PORT=5001
# Production: Node.js 24, NODE_ENV=production, plus the final site origin at BUILD time.
# Vercel: leave empty to use VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set SITE_URL later to override it with a custom domain; redeploy after changing it.
SITE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=portfolio_ga_v2
# Cloud database: enable TLS according to your provider's instructions.
DB_SSL=false
# Optional PEM CA certificate, using literal \n for line breaks:
DB_SSL_CA=
ADMIN_USER=your_admin_username
ADMIN_PASS=choose_a_unique_password
# ADMIN_PASS must be unique and at least 12 characters in production.
JWT_SECRET=replace_with_a_long_random_secret
# JWT_SECRET must be randomly generated and at least 32 characters in production.
# Optional email delivery:
GMAIL_USER=
GMAIL_APP_PASSWORD=
