{
  "name": "gaportfolio",
  "version": "1.0.0",
  "description": "Girma Ashetu — Software Engineering Portfolio",
  "main": "api.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "postinstall": "npm ci --prefix client",
    "db:migrate": "node scripts/migrate-projects.cjs",
    "test": "node --test tests/project-fields.test.cjs tests/project-api.test.cjs tests/project-schema.test.cjs tests/admin-auth.test.cjs tests/contact-handler.test.cjs tests/project-store.test.cjs tests/project-artwork.test.cjs tests/project-case-study.test.cjs tests/studio-loader.test.cjs tests/deployment.test.cjs",
    "verify:demos": "node scripts/verify-demos.cjs",
    "showcase:student": "node scripts/update-student-showcase.cjs",
    "check:deploy": "node scripts/check-deployment.cjs",
    "db:setup": "node scripts/setup-database.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "portfolio",
    "react",
    "vite",
    "nodejs"
  ],
  "author": "Girma Ashetu Asefa",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.20.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
